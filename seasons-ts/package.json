{
  "name": "@seasons/cli",
  "version": "4.0.0-dev",
  "description": "Seasons CLI — rewritten in TypeScript with Effect",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --noEmit",
    "seasons": "tsx src/main.ts"
  },
  "dependencies": {
    "effect": "^3.12.0",
    "@effect/schema": "^0.75.0",
    "@effect/cli": "^0.49.0",
    "@effect/platform": "^0.70.0",
    "@effect/platform-node": "^0.64.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0"
  },
  "bin": {
    "seasons": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
